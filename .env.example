# Token du bot Discord (Developer Portal → ton app → Bot → Reset Token)
DISCORD_TOKEN=

# Clé API Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# ID du serveur (recommandé : commandes slash disponibles tout de suite)
GUILD_ID=

# --- Apaisement des tensions HRP ---
# ID des salons HRP à surveiller, séparés par des virgules. Vide = désactivé.
TENSION_CHANNEL_IDS=
# Salon staff des alertes graves
TENSION_STAFF_CHANNEL_ID=
# Rôle staff à pinger lors d'une alerte grave (optionnel)
TENSION_STAFF_ROLE_ID=
# Modèle IA (défaut : claude-opus-5-5 ; claude-haiku-4-5 = ~4x moins cher, moins fin)
TENSION_MODEL=

# --- Sondage de présence quotidien ---
# Salon du sondage. Vide = désactivé.
PRESENCE_CHANNEL_ID=
# Rôle à pinger avec le sondage (optionnel)
PRESENCE_ROLE_ID=
# Heure de Paris (défaut 16:00)
PRESENCE_HOUR=
