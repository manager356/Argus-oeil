# Token du bot Discord
# Discord Developer Portal → ton app → Bot → Reset Token
DISCORD_TOKEN=

# Clé API Anthropic Claude
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ID du channel staff où les candidatures sont postées
# Discord : activer le mode développeur (Paramètres → Avancés)
# Puis : clic droit sur le channel → Copier l'ID du salon
STAFF_CHANNEL_ID=

# ID du serveur Argus (optionnel mais recommandé)
# Sans cet ID, les slash commands prennent jusqu'à 1h à se propager.
# Avec, elles sont disponibles immédiatement sur ce serveur uniquement.
GUILD_ID=

# --- Apaisement des tensions HRP (optionnel) ---
# ID des salons HRP à surveiller, séparés par des virgules. Vide = désactivé.
TENSION_CHANNEL_IDS=
# Salon des alertes graves (par défaut : STAFF_CHANNEL_ID)
TENSION_STAFF_CHANNEL_ID=
# Rôle staff à pinger lors d'une alerte grave (optionnel)
TENSION_STAFF_ROLE_ID=
# Modèle IA (défaut : claude-opus-5-5 ; claude-haiku-4-5 = ~4x moins cher, moins fin)
TENSION_MODEL=

# --- Sondage de présence quotidien (optionnel) ---
# Salon du sondage. Vide = désactivé.
PRESENCE_CHANNEL_ID=
# Rôle à pinger avec le sondage (optionnel)
PRESENCE_ROLE_ID=
# Heure de Paris (défaut 16:00)
PRESENCE_HOUR=
